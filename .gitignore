# =========================
# Global ignores
# =========================
# OS / Editor junk
.DS_Store
Thumbs.db
*.log
*.pem
*.pyc
*.pyo
*.pyd
__pycache__/
*.sqlite3
# Environment variables
.env
.env.*
!.env.example
# =========================
# Frontend (Next.js)
# =========================
# Dependencies
/frontend/node_modules
/frontend/.pnp
/frontend/.pnp.*
# Yarn (keep certain subfolders)
/frontend/.yarn/*
!/frontend/.yarn/patches
!/frontend/.yarn/plugins
!/frontend/.yarn/releases
!/frontend/.yarn/versions
# Build output
/frontend/.next/
/frontend/out/
/frontend/build
# Testing
/frontend/coverage
# TypeScript
/frontend/next-env.d.ts
/frontend/*.tsbuildinfo
# Vercel
/frontend/.vercel
# =========================
# Web (Vite)
# =========================
# Dependencies
/apps/web/node_modules
/apps/web/.pnp
/apps/web/.pnp.*
# Yarn (keep certain subfolders)
/apps/web/.yarn/*
!/apps/web/.yarn/patches
!/apps/web/.yarn/plugins
!/apps/web/.yarn/releases
!/apps/web/.yarn/versions
# Build output
/apps/web/dist
/apps/web/dist-ssr
/apps/web/build
# Vite cache
/apps/web/.vite
# Testing
/apps/web/coverage
# TypeScript
/apps/web/*.tsbuildinfo
# Editor directories
/apps/web/.vscode/*
!/apps/web/.vscode/extensions.json
/apps/web/.idea
# Temp files
/apps/web/*.local
/apps/web/*.temp

/apps/web/.vercel
.vercel
# =========================
# Backend (FastAPI)
# =========================
# Virtual environments
/backend/venv/
/backend/.venv/
/backend/env/
/backend/.env/
# Python caches and build artifacts
/backend/__pycache__/
/backend/*.pyc
/backend/*.pyo
/backend/*.pyd
/backend/.pytest_cache/
/backend/.mypy_cache/
/backend/.ruff_cache/
/backend/.coverage
/backend/htmlcov/
/backend/dist/
/backend/build/
# =========================
# Shared / general
# =========================
# IDE / Editor folders
.vscode/
.idea/
*.swp
# Coverage reports (anywhere)
coverage/
# Root-level node_modules (workspace root)
/node_modules
# =========================
# Misc
# =========================
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Lockfiles (optional — keep if you want deterministic builds)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
.vercel
