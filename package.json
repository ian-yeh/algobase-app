{
  "name": "algobase",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "convex": "^1.39.1",
    "jsonwebtoken": "^9.0.3"
  },
  "scripts": {
    "web": "npm run --workspace=@algobase/web",
    "web:dev": "npm run dev --workspace=@algobase/web",
    "web:build": "npm run build --workspace=@algobase/web",
    "web:lint": "npm run lint --workspace=@algobase/web",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "dev": "concurrently \"npm run web:dev\" \"npm run convex:dev\"",
    "build": "npm run web:build",
    "test:convex": "vitest run"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "concurrently": "^8.2.2",
    "convex-test": "^0.0.67",
    "vitest": "^5.1.0"
  }
}
