{
  "name": "algobase",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "convex": "^1.39.1",
    "jsonwebtoken": "^9.0.3"
  },
  "scripts": {
    "web": "npm run --workspace=@algobase/web",
    "web:dev": "npm run dev --workspace=@algobase/web",
    "web:build": "npm run build --workspace=@algobase/web",
    "web:lint": "npm run lint --workspace=@algobase/web",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "dev": "concurrently \"npm run web:dev\" \"npm run convex:dev\"",
    "build": "npm run web:build",
    "typecheck": "tsc -p packages/convex --noEmit && tsc -b apps/web",
    "test": "for f in $(git ls-files '*.check.ts'); do echo \"$f\" && esbuild \"$f\" --bundle --platform=node --log-level=warning --outfile=node_modules/.tmp/check.cjs && node node_modules/.tmp/check.cjs || exit 1; done",
    "test:convex": "vitest run"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "concurrently": "^8.2.2",
    "convex-test": "^0.0.67",
    "esbuild": "0.27.0",
    "vitest": "^5.1.0"
  }
}
